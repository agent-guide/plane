[Unit]
Description=Plane v2 orchestration worker (Procrastinate PG queue consumer)
After=plane-v2-api.service
[Service]
User=dongqian
WorkingDirectory=/opt/projects/ai-platform/v2/plane/api
EnvironmentFile=/opt/projects/ai-platform/v2/env/plane-api.env
ExecStart=/opt/projects/ai-platform/v2/plane/api/.venv/bin/python procrastinate_worker.py
# 看门狗（2026-11-11 挂死事故后补，2026-11-16 迁 Procrastinate 语义保留）：
# 入口心跳线程 + SSE 事件级双路喂狗；300s 无报平安=任意挂死（含未知挂法）
# → systemd 强杀重启；kill -9 残留 doing job 由 retry_stalled periodic 回收
Type=notify
WatchdogSec=300
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
