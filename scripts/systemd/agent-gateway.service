[Unit]
Description=Agent Gateway
After=network.target

[Service]
Type=simple
User=dongqian
Group=dongqian
WorkingDirectory=/opt/projects/ai-platform/agent-gateway
ExecStart=/bin/bash -c 'set -a; source /opt/projects/ai-platform/agent-gateway/.env; set +a; exec /opt/projects/ai-platform/agent-gateway/agw-linux run --config Caddyfile.experts'
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
