# 阿里云 plane api 非敏感配置模板（无凭据——凭据走 podman secret，§五）
# 用法：拷到服务器 /opt/plane/env/api.env 后按需微调；对照测试服 plane-api.env 键集
# 设计 docs/v2/aliyun-plane-stack-deploy-plan.md §五

# ── 数据层（容器网服务名）──
POSTGRES_DB=plane
POSTGRES_USER=plane
POSTGRES_HOST=pg
POSTGRES_PORT=5432
# POSTGRES_PASSWORD → secret plane-pg-pass
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379

# ── 对象存储（minio 容器）──
USE_MINIO=1
AWS_ACCESS_KEY_ID=plane
# AWS_SECRET_ACCESS_KEY → secret plane-minio-secret
AWS_S3_BUCKET_NAME=plane-uploads
AWS_REGION=us-east-1
MINIO_ENDPOINT_SSL=False
SIGNED_URL_EXPIRATION=7

# ── 外部地址（构建/运行两处一致）──
CORS_ALLOWED_ORIGINS=http://8.130.36.59:19100
WEB_URL=http://8.130.36.59:19100
WEB_BASE_URL=http://8.130.36.59:19100
APP_BASE_URL=http://8.130.36.59:19100
SPACE_BASE_URL=http://8.130.36.59:19100
LIVE_BASE_URL=http://8.130.36.59:19100

# ── 编排域 ──
# SECRET_KEY / LIVE_SERVER_SECRET_KEY / ORCHESTRATION_INTERNAL_TOKEN → secret
ORCHESTRATION_INTERNAL_BASE_URL=http://plane-api:8000
ORCHESTRATION_AIRFLOW_BASE_URL=http://airflow-api:8080
# Airflow 凭据换票（11-23）：用户名密码在 secret，worker 自动签发续期
ORCHESTRATION_DAG_ROOT=/opt/plane/airflow-dags
AGWMNGR_BASE_URL=http://agwmngr:3000
AGWMNGR_TENANT_ID=orch-v2
# AGWMNGR_TENANT_TOKEN → secret plane-tenant-token

# ── 开关/限额（照抄测试服值）──
DEBUG=0
DOCKERIZED=1
GUNICORN_WORKERS=1
FILE_SIZE_LIMIT=26214400
API_KEY_RATE_LIMIT=10000/hour
HARD_DELETE_AFTER_DAYS=30

# ── 疑似 v1 死键（v2 无 celery 进程）：照抄待冒烟后剔除 ──
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane@127.0.0.1:5672/plane
