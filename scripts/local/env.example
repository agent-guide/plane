# 本地栈环境唯一权威模板 —— `bash scripts/local/gen-env.sh` 读取本文件
# 生成 scripts/local/.env（gitignored，凭据落盘一次、此后幂等复用）。
# 端口口径 = runbook（gateway-agwmngr-upgrade-runbook-2026-11-16）：
#   plane web :3000 / api :8001；agwmngr :3300（避开 web 3000）；
#   gateway 数据面 :8080 / 管理 :8019 / caddy admin :2019；Airflow :8090。

# ── 端口 ──
WEB_PORT=3000
API_PORT=8001
MGR_PORT=3300
GW_DATA_PORT=8080
GW_ADMIN_PORT=8019
GW_CADDY_ADMIN_PORT=2019
AIRFLOW_PORT=8090
PG_PORT=5432
REDIS_PORT=6379

# ── Plane ──
PLANE_ADMIN_EMAIL=admin@v2.test
PLANE_ADMIN_PASSWORD=OrchV2Test!2026
PLANE_WORKSPACE_SLUG=orch-v2-local
PLANE_PROJECT_IDENTIFIER=LGX

# ── agwmngr（平台超管；SQLite data/manager.db）──
MGR_ADMIN_USER=v2admin
MGR_ADMIN_PASSWORD=OrchV2Admin!

# ── agent-gateway（admin basic；hash 由 gen-env 生成写入 Caddyfile）──
GW_ADMIN_USER=default
GW_ADMIN_PASSWORD=OrchV2Admin!

# ── 租户（平台链：租户 + plane 侧服务主体）──
TENANT_ID=orch-v2
TENANT_SVC_NAME=orch-plane-admin

# ── 上游真实模型（agentguide GLM，Anthropic 协议；留空则不配 LLM 路由）──
LLM_PROVIDER_ID=glm-ccchat
LLM_PROVIDER_TYPE=anthropic
LLM_BASE_URL=https://agentguide.online/agw/glm/ccchat
LLM_MODEL=claude-opus-4-8
LLM_API_KEY=__SET_ME__   # 填 agentguide VK（sk- 不接受，vk- 开头）

# ── 本机路径 / 网关注册 ID（各机不同，逐机覆盖；缺省用 common.sh 约定值）──
# GW_ID=agw-local                       # agwmngr 侧注册的网关 ID
# GW_DIR=$HOME/Desktop/shu/agent-gateway
# MGR_DIR=$HOME/Desktop/shu/agwmngr
# AIRFLOW_HOME_DIR=$HOME/airflow-local
# AF=$AIRFLOW_HOME_DIR/.venv/bin/airflow
# PSQL=/path/to/psql                    # 仅当 psql 不在 PATH 时显式指定
# REDIS_CLI=/path/to/redis-cli          # 仅当 redis-cli 不在 PATH 时显式指定
