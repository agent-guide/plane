# airflow api-server（web/API 进程）→ 本机 18090
# 官方镜像直用（DAG 运行时仅 stdlib+requests，官方镜像已含——免自建层）
# 测试服实证进程分工：api_server / scheduler / worker 各自独立（11-27 ps 复核）
[Container]
Image=docker.io/apache/airflow:3.3.2-python3.11
ContainerName=airflow-api
Network=agw-net
PublishPort=127.0.0.1:18090:8080
User=root
Exec=airflow api-server
EnvironmentFile=/opt/plane/env/airflow.env
Volume=/opt/plane/airflow-dags:/opt/airflow/dags:Z
Volume=/opt/plane/airflow-users.cfg:/opt/airflow/simple_auth_manager/users.cfg:ro,Z
Secret=plane-airflow-db-pass

[Service]
Restart=always
